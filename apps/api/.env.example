NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

DATABASE_URL="postgresql://cripto:cripto@localhost:5432/criptocuritiba_dev?schema=public"

# Origens do CORS (aceita * para previews da Vercel)
CORS_ORIGINS=http://localhost:3000,https://criptocuritiba-web-one.vercel.app,https://criptocuritiba-web-*.vercel.app

# Revalidacao do ISR (ADR-0007) - sempre a URL de producao
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=troque-este-valor

# Admin (ADR-0006) - 32+ caracteres
JWT_SECRET=troque-por-32-bytes-aleatorios-no-minimo
JWT_EXPIRES_IN=7d

# Anti-spam do formulario de sugestao
TURNSTILE_SECRET_KEY=

# Segredo compartilhado com o BFF do Next para confiar no IP que ele repassa
# (16+ caracteres) - mesmo valor de PROXY_TRUST_SECRET em apps/web/.env
PROXY_TRUST_SECRET=troque-por-um-valor-aleatorio

UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_URL=http://localhost:3333/uploads
